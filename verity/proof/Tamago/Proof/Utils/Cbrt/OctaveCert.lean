import Mathlib.Tactic.FinCases

/-
  Finite certificate for cbrt upper bound, covering octaves 8..255.

  For each octave i (offset from 8), the tables provide:
  - loOf(i): lower bound on icbrt(x) for x in [2^(i+8), 2^(i+9)-1]
  - hiOf(i): upper bound on icbrt(x)
  - seedOf(i): the cbrt seed for the octave
  - maxAbsOf(i): max|seed - m| for m in [lo, hi]
  - d1Of(i): first-step error bound (analytic)
  - nextD, d2..d5: chained error recurrence

  All 248 octaves verified: d5 <= 1 and 2*dk <= lo for k=1..4.
-/

namespace Tamago.Proof.Utils.Cbrt.OctaveCert

set_option maxRecDepth 1000000

